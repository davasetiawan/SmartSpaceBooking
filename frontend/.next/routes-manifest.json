      "routeKeys": {},
      "namedRegex": "^/admin/members(?:/)?$"
    },
    {
      "page": "/admin/profile",
      "regex": "^/admin/profile(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/profile(?:/)?$"
    },
    {
      "page": "/admin/reservations",
      "regex": "^/admin/reservations(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/reservations(?:/)?$"
    },
    {
      "page": "/admin/spaces",
      "regex": "^/admin/spaces(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/spaces(?:/)?$"
    },
    {
      "page": "/admin/vouchers",
      "regex": "^/admin/vouchers(?:/)?$",
